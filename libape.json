{
    "name": "libape",
    "description": "Monkey's Audio decoder",
    "filters":["apedec"],
    "help": "This filter decodes Monkey's Audio (.ape) files using the Monkey's Audio SDK.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libape.accessor",
    "filter_source":{
        "apedec" : "dec_ape.cpp"
    },
    "extension":{
      "ape" : "audio"
    },
    "using": ["mm_solver_minimal_1.0.1", "mm_solver_1.0.1", "mm_solver_1.0.2"],
    "patents": {
        "status": "royalty-free",
        "note": "Monkey's Audio",
        "checked": "2026-10-16"
    }
}
